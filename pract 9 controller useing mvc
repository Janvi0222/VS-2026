<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Student Details</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 40px;
        }

        .container {
            width: 500px;
            margin: auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px #cccccc;
        }

        h1 {
            text-align: center;
        }

        p {
            padding: 8px;
            border-bottom: 1px solid #dddddd;
        }

        .label {
            font-weight: bold;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Student Details</h1>

        <p>
            <span class="label">Roll Number:</span>
            @ViewBag.RollNo
        </p>

        <p>
            <span class="label">Name:</span>
            @ViewBag.Name
        </p>

        <p>
            <span class="label">Course:</span>
            @ViewBag.Course
        </p>

        <p>
            <span class="label">Email:</span>
            @ViewBag.Email
        </p>

        <p>
            <span class="label">City:</span>
            @ViewBag.City
        </p>

        <p>
            <span class="label">Marks:</span>
            @ViewBag.Marks
        </p>

        <a class="back" href="/Student/Index">
            Back to Student Information
        </a>

    </div>

</body>
</html>


